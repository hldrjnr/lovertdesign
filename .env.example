# ---------------------------------------------------------------------------
# Lovert Design — variáveis de ambiente
# Copie para `.env` (local) ou defina como *secrets* no GitHub Actions.
# NUNCA faça commit do `.env` real.
# ---------------------------------------------------------------------------

# ID do produto Gumroad usado para verificar as licenças.
# Obtenha em: Gumroad → Product → Advanced → Product ID
GUMROAD_PRODUCT_ID=

# Webhook do Discord usado pelo formulário de feedback.
# Deixe vazio para desativar o feedback (o binário fica limpo, sem URLs embutidos).
DISCORD_WEBHOOK_URL=

# Chave XOR usada apenas para ofuscar o cache local da licença (`license.dat`).
# É opcional: se ficar vazia, é usada uma chave não-sensível por omissão.
LICENSE_XOR_KEY=
